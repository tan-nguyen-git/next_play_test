# Copy this file to .env.local and fill in your own Supabase project values.
# These are PUBLIC browser values: anything prefixed with VITE_ is bundled into
# the frontend and visible to every visitor. Data is protected by Row Level
# Security, not by hiding these. Never put a service role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
